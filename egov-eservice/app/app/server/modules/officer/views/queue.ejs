<%
  const isOfficer = user.role === 'officer';
  const filters = [['all', 'ทั้งหมด'], ['unclaimed', 'ยังไม่มีผู้รับ'], ['mine', 'ของฉัน']];
  const stepLabel = { 1: 'ขั้นตอน 1/3 · ฝ่ายทะเบียน', 2: 'ขั้นตอน 2/3 · ฝ่ายโยธา', 3: 'ขั้นตอน 3/3 · หัวหน้าฝ่าย' };
%>
<div class="card queue-toolbar">
  <form class="row" method="get" action="/officer/queue" id="queue-filter-form">
    <label for="queue-filter" class="inline-label">แสดง</label>
    <select id="queue-filter" name="filter" data-testid="queue-filter">
<% for (const [value, label] of filters) { %>      <option value="<%= value %>"<%= filter === value ? ' selected' : '' %>><%= label %></option>
<% } %>    </select>
    <noscript><button type="submit" class="btn-sm">กรอง</button></noscript>
  </form>
<% if (isOfficer) { %>
  <p class="workload">งานในมือของฉัน: <strong data-testid="workload-count"><%= workload %></strong> / 10 เรื่อง
    <span class="muted">(แผนก<%= fmt.deptText(user.dept) %>)</span></p>
<% } else { %>
  <p class="muted">หัวหน้าฝ่ายดูคิวทุกแผนกได้ (อ่านอย่างเดียว)</p>
<% } %>
</div>

<div id="queue-results">
<% if (!rows.length) { %>
<p class="card" data-testid="queue-empty">ไม่มีงานในคิว</p>
<% } else { %>
<div class="table-wrap" role="region" aria-label="ตารางคิวงาน" tabindex="0">
  <table data-testid="queue-table">
    <caption class="sr-only">คิวงาน เรียงตามกำหนดเสร็จเร็วสุดก่อน แล้วตามเลขคำขอ</caption>
    <thead>
      <tr>
        <th scope="col">เลขคำขอ</th>
        <th scope="col">บริการ</th>
        <th scope="col">ผู้ยื่น</th>
        <th scope="col">เลขบัตร</th>
        <th scope="col">สถานะ</th>
        <th scope="col">กำหนดเสร็จ</th>
        <th scope="col">ระดับเตือน</th>
        <th scope="col">ผู้ถือเรื่อง</th>
<% if (isOfficer) { %>        <th scope="col"><span class="sr-only">ดำเนินการ</span></th>
<% } %>      </tr>
    </thead>
    <tbody>
<% for (const r of rows) { %>
      <tr data-testid="queue-row" data-case-no="<%= r.caseNo %>" data-owner="<%= r.owner || '' %>"
          data-status="<%= r.status %>" data-sla-level="<%= r.slaLevel %>">
        <td><a data-testid="row-case-no" href="/officer/cases/<%= r.caseNo %>"><%= r.caseNo %></a></td>
        <td><span data-testid="row-service"><%= r.serviceId %> <%= fmt.serviceName(r.serviceId) %></span>
<% if (r.step) { %>          <br><span class="muted small"><%= stepLabel[r.step] || '' %></span>
<% } %>        </td>
        <td data-testid="row-applicant"><%= r.applicantName %></td>
        <td data-testid="row-id-masked"><%= r.idMasked %></td>
        <td><span data-testid="row-status" class="chip status-<%= r.status %>" data-status="<%= r.status %>"><%= fmt.statusText(r.status) %></span></td>
        <td><%- fmt.timeHtml(r.dueAt, 'row-due') %></td>
        <td><span data-testid="row-sla-level" class="chip level-<%= r.slaLevel %>" data-level="<%= r.slaLevel %>"><%= fmt.levelText(r.slaLevel) %></span></td>
        <td><span data-testid="row-owner"><%= r.owner || '' %></span><% if (r.status === 'APPROVED') { %><span class="muted small">รอออกเอกสาร</span><% } %></td>
<% if (isOfficer) { %>        <td><% if (r.canClaim) { %><button type="button" class="btn-sm" data-testid="claim-btn" data-action="claim" data-case-no="<%= r.caseNo %>">รับเรื่อง</button><% } %></td>
<% } %>      </tr>
<% } %>
    </tbody>
  </table>
</div>
<% } %>
</div>
