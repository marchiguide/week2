<form class="card" data-admin-method="POST" data-admin-reload action="/api/admin/holidays" aria-label="เพิ่มวันหยุด">
  <div class="grid">
    <div class="field">
      <label for="holiday-date">วันที่</label>
      <input type="date" id="holiday-date" name="date" data-testid="holiday-date-input" required>
    </div>
    <div class="field">
      <label for="holiday-name">ชื่อวันหยุด</label>
      <input type="text" id="holiday-name" name="name" data-testid="holiday-name-input" required>
    </div>
  </div>
  <button type="submit" data-testid="holiday-add-btn">เพิ่มวันหยุด</button>
</form>

<div class="table-wrap">
  <table>
    <caption class="sr-only">รายการวันหยุด</caption>
    <thead><tr><th scope="col">วันที่</th><th scope="col">ชื่อวันหยุด</th><th scope="col">จัดการ</th></tr></thead>
    <tbody>
      <% for (const holiday of holidays) { %>
        <tr data-testid="holiday-row" data-date="<%= holiday.date %>">
          <td><%- fmt.timeHtml(holiday.date, null, {}, { dateOnly: true }) %></td>
          <td><%= holiday.name %></td>
          <td>
            <form data-admin-method="DELETE" data-admin-reload action="/api/admin/holidays/<%= holiday.date %>">
              <button type="submit" class="btn-danger btn-sm" data-testid="holiday-delete-btn" data-date="<%= holiday.date %>"
                      aria-label="ลบวันหยุด <%= holiday.name %>">ลบ</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
